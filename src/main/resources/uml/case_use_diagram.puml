@startuml
skinparam actorStyle awesome
left to right direction

actor "User" as U
actor "Admin" as A

rectangle "Todo Cine System" {

    package "User Management" {
        U -- (Register/Login)
        U -- (View Profile)
        U -- (Update Profile)
    }

    package "Movie Catalog" {
        U -- (Search Movies)
        U -- (View Movie Details)
        U -- (List Movies Playing in Theaters)
        (List Movies Playing in Theaters) ..> (Filter by Region) : <<extend>>
    }

    package "Social & Interactions" {
        U -- (Mark as Favorite)
        U -- (Mark as Watched)
        U -- (Rate Movie)
        U -- (View Personal Favorite)
        (View Personal Favorite) ..> (Filter by Watched/Rated) : <<extend>>

    }

    package "Awards & History" {
        U -- (View Winners by Year)
        A -- (Insert New Winner)
    }

    package "Custom lists" {
        U -- (Manage Custom Lists)
        (Manage Custom Lists) <|-- (Create list)
        (Manage Custom Lists) <|-- (Edit list)
        (Manage Custom Lists) <|-- (Delete list)

        U -- (View Lists)
        (View Lists) <|-- (View owned lists)
        (View Lists) <|-- (View public lists)

        U -- (Manage List Movies)
        (Manage List Movies) <|-- (Add movie to list)
        (Manage List Movies) <|-- (Remove movie from list)

        U -- (Manage List Opinions)
        (Manage List Opinions) <|-- (Share opinion about a list)
        (Manage List Opinions) <|-- (View opinions about a list)
    }
}

' Inheritance: Admin can do everything a User can
A --|> U


@endum